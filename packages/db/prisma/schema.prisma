generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// AUTH MODELS
// ─────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  domains       Domain[]
  notifications Notification[]
  payments      Payment[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────
// PRICING CONFIG
// ─────────────────────────────────────────

// Single row table — only one PricingConfig ever exists (id = "default")
// Change price here → affects all future payments automatically
// Never hard delete this row

model PricingConfig {
  id              String   @id @default("default")
  paidDomainPrice Int      @default(2000)// INR paise — 2000 = ₹20
  updatedAt       DateTime @updatedAt

  @@map("pricing_config")
}

// ─────────────────────────────────────────
// DOMAIN MODELS
// ─────────────────────────────────────────

// DomainType:
//   FREE  → active for 10 days from createdAt, all features included
//           on expiry: DEACTIVATED, must pay to reactivate (no free second chance)
//   PAID  → active for 30 days from payment date
//           Extend: adds 30 days on top of current endsAt (only when ACTIVE)
//           Reactivate: fresh 30 days from payment date (when DEACTIVATED)

// DomainState:
//   ACTIVE      → event collection ON, dashboard ON
//   DEACTIVATED → event collection OFF, dashboard OFF
//                 reversed by: payment (reactivate or extend)

// Soft delete via deletedAt — never hard delete 

enum DomainType {
  FREE
  PAID
}

enum DomainState {
  ACTIVE
  DEACTIVATED
}


model Domain {
  id               String      @id @default(uuid())
  userId           String
  domainName       String      @unique
  apikey           String      @unique
  type             DomainType  @default(FREE)
  state            DomainState @default(ACTIVE)
  endsAt           DateTime    // FREE: createdAt + 10 days | PAID: paymentDate + 30 days
  deletedAt        DateTime?   // soft delete
  defaultTimezone  String      @default("UTC")
  expectedVisitors Int         @default(7)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageVisits  PageVisit[]
  pageHiddens PageHidden[]
  payments    Payment[]

  @@index([userId])
  @@index([userId, state])
  @@index([state, endsAt])   // cron job: find expired domains
  @@map("domain")
}

// ─────────────────────────────────────────
// PAYMENT MODELS
// ─────────────────────────────────────────

// PaymentPurpose:
//   REACTIVATE → domain was DEACTIVATED (expired FREE or expired PAID)
//                result: type → PAID, fresh endsAt = paymentDate + 30 days
//   EXTEND     → domain is currently ACTIVE + PAID
//                result: endsAt = current endsAt + 30 days

// amount: snapshot of price at time of payment (so price changes don't affect history)
// razorpaySignature: required for webhook verification — never skip
// failureReason: filled when status = FAILED

enum PaymentPurpose {
  REACTIVATE
  EXTEND
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId          String
  domain            Domain         @relation(fields: [domainId], references: [id])
  purpose           PaymentPurpose
  amount            Int            // INR paise (snapshot at time of payment)
  razorpayOrderId   String         @unique
  razorpayPaymentId String?        @unique  // filled after SUCCESS
  razorpaySignature String?                 // filled after webhook verification
  status            PaymentStatus  @default(PENDING)
  failureReason     String?                 // filled when FAILED
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
  @@index([domainId])
  @@map("payment")
}

// ─────────────────────────────────────────
// ANALYTICS MODELS
// ─────────────────────────────────────────

model PageVisit {
  id         String   @id @default(uuid())
  domainName String
  domainId   String
  visitorId  String
  visitedAt  DateTime
  timezone   String?
  page       String
  pageTitle  String?
  referrer   String?
  country    String?
  browser    String?
  device     String?
  os         String?
  exitType   String?
  timeSpent  Int

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, visitedAt])
  @@index([domainId, visitorId])
  @@index([domainId, page])
  @@map("page_visit")
}

model PageHidden {
  id        String   @id @default(uuid())
  domainId  String
  visitorId String
  page      String
  hiddenAt  DateTime
  hiddenFor Int

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, hiddenAt])
  @@index([domainId, page])
  @@map("page_hidden")
}

// ─────────────────────────────────────────
// NOTIFICATION MODELS
// ─────────────────────────────────────────

enum NotificationType {
  SPIKE_ALERT
  DOMAIN_EXPIRING  // sent X days before endsAt as a warning
  DOMAIN_EXPIRED   // sent when cron deactivates the domain
  BILLING
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notification")
}
